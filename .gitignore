# Build / env
.venv/
dist/
*.egg-info/
__pycache__/
*.pyc

# Native build output (compiled on first use)
native/soda_helper
src/soda_stt/soda_helper

# Engine + models staged into the package by scripts/bundle.py (then shipped
# in the wheel; the wheel is the artifact, not the git tree)
src/soda_stt/_bundle/

# Downloaded engine + models, and local caches (fetched on demand)
artifacts/
.soda_home/
.cache/
.scratch/

# RE scratch and large test media
probe/
testdata/*.mp3
testdata/*.wav
testdata/*.pcm
